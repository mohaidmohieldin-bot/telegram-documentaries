#!/usr/bin/env bash
# Install a git pre-commit hook that runs lint, typecheck and tests.
# Run `scripts/hooks --run` to run the same checks without installing.
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ "${1:-}" == "--run" ]]; then
  scripts/lint
  scripts/typecheck
  scripts/test
  exit 0
fi
hook=.git/hooks/pre-commit
printf '#!/usr/bin/env bash\nset -euo pipefail\nexec scripts/hooks --run\n' > "$hook"
chmod +x "$hook"
echo "Installed $hook"
